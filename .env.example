# ==============================================================================
# Crimson Veil — Exemplo de Variáveis de Ambiente Locais (.env)
# ==============================================================================
# IMPORTANTE: Nunca insira chaves reais neste arquivo e nunca versione seu .env!
# O backend Crimson Veil carrega prioritariamente o arquivo em 'backend/.env'.
#
# Para configurar seu ambiente local:
# 1. Copie este arquivo para 'backend/.env' (ou use backend/.env.example):
#      cp .env.example backend/.env
# 2. Preencha a GEMINI_API_KEY com sua chave pessoal do Google AI Studio.
# 3. Inicie o backend pelo VS Code ou pelo terminal.
# ==============================================================================

# Chave de API do Google Gemini (Obrigatória para geração narrativa da IA)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo padrão do Google Gemini (Opcional - padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Endereço base da API Gemini (Opcional)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Tempo limite de resposta da API em segundos (Opcional - padrão: 30)
GEMINI_TIMEOUT_SECONDS=30

# Limite máximo de tokens gerados por resposta (Opcional - padrão: 1000)
GEMINI_MAX_OUTPUT_TOKENS=1000

# Temperatura do modelo (Opcional - padrão: 0.7)
GEMINI_TEMPERATURE=0.7

# Porta do servidor Spring Boot (Opcional - padrão: 8080)
PORT=8080
