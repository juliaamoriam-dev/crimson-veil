# ==============================================================================
# Crimson Veil — Exemplo de Variáveis de Ambiente Locais (.env)
# ==============================================================================
# IMPORTANTE: Nunca insira chaves reais neste arquivo e nunca versione seu .env!
# Para configurar seu ambiente local:
# 1. Copie este arquivo para 'backend/.env':
#      cp backend/.env.example backend/.env   (ou copie manualmente no VS Code)
# 2. Preencha a GEMINI_API_KEY com sua chave pessoal do Google AI Studio.
# 3. Inicie o backend normalmente pelo VS Code ou terminal.
# ==============================================================================

# Chave de API do Google Gemini (Obrigatória para geração narrativa da IA)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo padrão do Google Gemini (Opcional - padrão no backend: gemini-3.8-flash)
# Modelos válidos: gemini-3.8-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

# Endereço base da API Gemini (Opcional)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Tempo limite de resposta da API em segundos (Opcional - padrão: 30)
GEMINI_TIMEOUT_SECONDS=30

# Limite máximo de tokens gerados pela IA por turno narrativo (Opcional - padrão: 1000)
GEMINI_MAX_OUTPUT_TOKENS=1000

# Temperatura do modelo (Opcional - padrão: 0.7 para estilo narrativo noir equilibrado)
GEMINI_TEMPERATURE=0.7

# Porta do servidor backend Spring Boot (Opcional - padrão: 8080)
PORT=8080
